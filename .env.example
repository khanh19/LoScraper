# Export these in your shell or set GitHub repository secrets. Never commit .env.
DATABASE_URL=
SERPAPI_API_KEY=
BRIGHTDATA_API_KEY=
# Optional: a JSON receipt from the provider dashboard, valid for at most 24 hours.
# Bright Data does not expose free credits or auto-recharge status via API.
# {"verified_at":"ISO_TIMESTAMP","unfunded":true,"no_payment_method":true,"auto_recharge":false,"free_credits_remaining":0}
BRIGHTDATA_FREE_VERIFICATION_JSON=
# Local Mac browser reuse; omit in CI after installing Chromium.
LO_BROWSER_CHANNEL=chrome
